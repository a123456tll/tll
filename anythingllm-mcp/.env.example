# AnythingLLM MCP 服务配置示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
#
# 获取 API Key：AnythingLLM 界面 -> Settings -> API Keys -> New API Key

# 必填：AnythingLLM API Key
ANYTHINGLLM_API_KEY=

# 可选：AnythingLLM 服务地址，默认 http://localhost:3001
ANYTHINGLLM_URL=http://localhost:3001

# 可选：目标 workspace slug，默认 ai
ANYTHINGLLM_WORKSPACE=ai
